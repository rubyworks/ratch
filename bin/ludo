#!/usr/bin/env ruby

# ludo: "lookup and do". Looks for an executable script by name, in the
# present directory and then in each directory above it, and runs the
# first one found, from the directory it is in, passing along any further
# arguments.
#
#   $ ludo script/test --verbose

name, *args = ARGV

if name.nil? || name == '-h' || name == '--help'
  $stderr.puts "Usage: ludo SCRIPT [ARGUMENTS]"
  $stderr.puts "Run the first executable SCRIPT found in this directory or one above it."
  exit(name.nil? ? 1 : 0)
end

dir = Dir.pwd

loop do
  file = File.join(dir, name)
  if File.file?(file) && File.executable?(file)
    Dir.chdir(dir)
    exec(file, *args)
  end
  parent = File.dirname(dir)
  break if parent == dir
  dir = parent
end

$stderr.puts "ludo: script not found -- #{name}"
exit 1
